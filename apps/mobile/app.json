{
  "expo": {
    "name": "知闲",
    "slug": "zhixian",
    "version": "0.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-book-light.png",
    "scheme": "zhixian",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhanghuiwan.zhixian"
    },
    "android": {
      "package": "com.zhanghuiwan.zhixian",
      "versionCode": 6,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#141615"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "defaultLaunchURL": "http://127.0.0.1:8081"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
