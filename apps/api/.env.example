APP_NAME=知闲 API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./zhixian.db
SECRET_KEY=local-development-secret-change-before-deploy
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AI_CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
CREATE_DEMO_USER=true
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_MAX_AGENT_STEPS=6
AI_MAX_TOOL_CALLS=10
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=24
