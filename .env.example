# Copy this file to .env for Docker Compose deployment.
POSTGRES_DB=zhixian
POSTGRES_USER=zhixian
POSTGRES_PASSWORD=please-change-this-password
SECRET_KEY=please-generate-a-long-random-secret
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_MAX_AGENT_STEPS=6
AI_MAX_TOOL_CALLS=10
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=24
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CREATE_DEMO_USER=false
